# Dev-only image for `docker compose up`: runs the Vite dev server with hot reload.
# (Production frontend is built and hosted by Vercel, not Docker.)
FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
