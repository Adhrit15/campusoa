# Copy to .env (git-ignored) and fill in. NEVER commit .env.
# The same variable names are set in the Render dashboard for production.

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Who may sign in / who is admin (comma-separated, lowercase) ---
ALLOWED_EMAIL_DOMAINS=cbit.ac.in
ADMIN_EMAILS=

# --- URLs. Locally everything goes through the Vite dev server on 5173. ---
APP_PUBLIC_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# --- Database. Local default matches docker-compose.yml. ---
# Production (Neon): jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/campusoa
DATABASE_USERNAME=campusoa
DATABASE_PASSWORD=campusoa

# --- Optional ---
SCRAPER_ENABLED=false
# Put your repo URL here so the site owner can identify the bot:
SCRAPER_USER_AGENT=CampusOABot/1.0 (+https://github.com/<you>/campusoa; unofficial student project)
RATE_LIMIT_WRITES_PER_MINUTE=30
COOKIE_SECURE=false
